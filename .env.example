# Copy to .env and fill in only what you need.
# With the recommended bootstrap (ed25519 key + NOPASSWD sudo) none of these are required.

# Passphrase for the cluster SSH private key, if you created one with a passphrase.
VANTA_KEY_PASSPHRASE=

# Only used when a node is configured with "auth": "password".
VANTA_SSH_PASSWORD=

# Only used when a node is configured with "sudo": "password".
VANTA_SUDO_PASSWORD=

# Optional: override the inventory file location (default: cluster.config.local.json).
# Linux:   VANTA_CONFIG=/srv/VantaMCPd/cluster.config.local.json
# Windows: VANTA_CONFIG=C:\path\to\VantaMCPd\cluster.config.local.json

# Optional: override the TOFU host-key store location.
# Linux:   VANTA_KNOWN_HOSTS=~/.vanta/known_hosts.json
# Windows: VANTA_KNOWN_HOSTS=C:\Users\username\.vanta\known_hosts.json

