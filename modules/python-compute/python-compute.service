[Unit]
Description=VantaMCPd Python Compute broker
After=local-fs.target

[Service]
Type=simple
User=vantamcpd-python
Group=vantamcpd-python
EnvironmentFile=/etc/vantamcpd/python-compute.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/vantamcpd/modules/python-compute/current/service.py
Restart=on-failure
RestartSec=3s
RuntimeDirectory=vantamcpd-python
RuntimeDirectoryMode=0755
StateDirectory=vantamcpd-python
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# ProtectKernelTunables, ProtectKernelLogs, ProtectHostname and RestrictSUIDSGID are deliberately
# absent. The first three bind-mount inside /proc, which stops bubblewrap mounting a fresh procfs in its
# PID namespace, and the fourth filters openat2, which bubblewrap uses for mounts. The broker runs
# unprivileged with no capabilities, and every call is confined by bubblewrap instead.
# bubblewrap needs AF_NETLINK to bring up loopback inside its empty network namespace.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Conservative floors for a small node. The installer overrides these in a generated drop-in sized from
# the node's own memory and cores.
MemoryHigh=450M
MemoryMax=700M
CPUQuota=100%
CPUWeight=50
Nice=5
TasksMax=96
TimeoutStopSec=8s
KillMode=mixed

[Install]
WantedBy=multi-user.target
